# ─── AI Study Assistant — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your keys.
# For Supabase Edge Functions (production), set secrets via:
#   supabase secrets set GEMINI_API_KEY=your_key_here

# Google Gemini API (PDF, Image, YouTube summarization + chat)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# PDF text extraction (PDF Learning Engine upload handler)
# Get a key: https://pdfrest.com/
PDFREST_API_KEY=your_pdfrest_key_here

# Allow the backend to start without GEMINI_API_KEY (uses demo/offline responses)
ALLOW_DEMO_MODE=true

# Optional: override Gemini models
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_VISION_MODEL=gemini-1.5-flash
